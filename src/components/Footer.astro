---
import { footer, navGroups, quickLinks, site } from '../data/site';

const columns = [...navGroups, { title: 'Acesso Rápido', links: quickLinks }];
const year = new Date().getFullYear();
---

<footer class="footer theme-dark">
  <div class="container">
    <div class="footer-about">
      <a href="/" class="footer-brand">
        <img src={site.crest} alt="" class="footer-crest" loading="lazy" />
        <span class="footer-brand-title">{site.name}</span>
        <span class="footer-brand-subtitle">{footer.subtitle}</span>
      </a>
      <p class="footer-text">{footer.about}</p>
    </div>

    <nav class="footer-links" aria-label="Rodapé">
      {
        columns.map((group) => (
          <div>
            <p class="footer-links-title">{group.title}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="footer-bottom">
      <div class="footer-legal">
        <p>© {year} {site.fullName}</p>
        {footer.legal.map((line) => <p>{line}</p>)}
      </div>
      <p>{footer.credit}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding-block: var(--section-m) var(--section-s);
    background: var(--c-cherry);
    color: var(--text);
  }

  .footer-about {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--c-white);
    text-decoration: none;
  }
  .footer-crest {
    height: 5.5rem;
    width: auto;
    filter: brightness(0) invert(1) drop-shadow(0 0 12px rgba(255, 255, 255, 0.25));
  }
  .footer-brand-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .footer-brand-subtitle {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .footer-text {
    max-width: 36rem;
    font-size: var(--fs-s);
    text-wrap: pretty;
    opacity: 0.85;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2rem;
    margin-block: var(--section-s);
  }
  .footer-links-title {
    padding-block: 0.5rem;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    color: var(--c-mauve);
  }
  .footer-links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .footer-links a {
    font-size: var(--fs-s);
    text-decoration: none;
    opacity: 0.85;
  }
  .footer-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-s);
    opacity: 0.75;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  @media (max-width: 767px) {
    .footer-about {
      flex-direction: column;
    }
  }
</style>
