---
import Eyebrow from '../ui/Eyebrow.astro';
import MorphSlider from '../MorphSlider.astro';
import { gallery } from '../../data/site';
import { rich } from '../../lib/rich';
---

<section class="gallery theme-dark">
  <div class="container">
    <header class="gallery-header">
      <Eyebrow text={gallery.eyebrow} center />
      <h2 set:html={rich(gallery.title)} />
      <p>{gallery.text}</p>
    </header>
    <div class="gallery-slider">
      <MorphSlider
        items={gallery.items}
        transition="melt"
        intensity={0.55}
        aberration={0.35}
        drift={0.4}
        autoplayDelay={4.5}
        radius={24}
        overlayColor="#12071f"
        label="Visões do castelo"
      />
    </div>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--section-m);
    overflow: hidden;
    background: radial-gradient(100% 60% at 50% 10%, #200a38 0%, var(--c-night) 100%);
  }
  .gallery-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 4rem;
    text-align: center;
  }
  .gallery-header p {
    max-width: 600px;
    opacity: 0.75;
  }
  .gallery-slider {
    position: relative;
    width: 100%;
    max-width: 1180px;
    height: clamp(420px, 65vh, 720px);
    margin-inline: auto;
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 24px;
    box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.85), 0 0 50px rgba(168, 85, 247, 0.2);
  }
</style>
