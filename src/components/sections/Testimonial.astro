---
import { testimonial } from '../../data/site';
---

<section class="testimonial theme-dark">
  <figure class="testimonial-inner" data-reveal>
    <blockquote>
      <p>{testimonial.quote}</p>
    </blockquote>
    <figcaption>
      <span class="testimonial-name">{testimonial.name}</span>
      <span class="testimonial-role">{testimonial.role}</span>
    </figcaption>
  </figure>
</section>

<style>
  .testimonial {
    padding: var(--section-s) var(--page-padding);
    background: var(--c-dusk);
  }
  .testimonial-inner {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1.35;
    text-wrap: balance;
  }
  blockquote p::before,
  blockquote p::after {
    color: var(--c-mauve);
    font-size: 1.4em;
    line-height: 0;
    vertical-align: -0.25em;
  }
  blockquote p::before {
    content: '“';
    margin-right: 0.15em;
  }
  blockquote p::after {
    content: '”';
    margin-left: 0.15em;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .testimonial-name {
    font-weight: 600;
  }
  .testimonial-role {
    font-size: var(--fs-s);
    opacity: 0.7;
  }
</style>
