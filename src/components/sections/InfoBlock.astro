---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { rich } from '../../lib/rich';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  cta: { label: string; href: string };
  image: { src: string; alt: string };
  imageSide: 'left' | 'right';
}

const { eyebrow, title, text, cta, image, imageSide } = Astro.props;
---

<section class:list={['info', `image-${imageSide}`]}>
  <div class="container info-grid">
    <div class="info-text" data-reveal>
      <Eyebrow text={eyebrow} />
      <h2 set:html={rich(title)} />
      <p>{text}</p>
      <div>
        <Button href={cta.href} variant="secondary">{cta.label}</Button>
      </div>
    </div>
    <figure class="info-media">
      <img src={image.src} alt={image.alt} loading="lazy" />
    </figure>
  </div>
</section>

<style>
  .info {
    padding-block: var(--section-s);
    background: var(--bg-2);
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 2rem 4rem;
  }
  .image-left .info-media {
    order: -1;
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .info-text p {
    font-size: var(--fs-l);
  }

  .info-media {
    aspect-ratio: 1;
    border-radius: var(--radius-s);
    overflow: clip;
    view-timeline: --info-media;
  }
  .info-media img {
    width: 100%;
    height: 110%;
    object-fit: cover;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .info-media img {
        animation: parallax linear both;
        animation-timeline: --info-media;
        animation-range: cover 20% cover 80%;
      }
      @keyframes parallax {
        to {
          translate: 0 -9%;
        }
      }
    }
  }

  @media (max-width: 767px) {
    .info-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .image-left .info-media {
      order: 0;
    }
  }
</style>
