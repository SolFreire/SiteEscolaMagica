---
// Rastro mágico roxo que segue o cursor (ou o dedo, no toque).
---

<canvas class="wand-cursor" aria-hidden="true" data-wand></canvas>

<style>
  .wand-cursor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    pointer-events: none;
  }
</style>

<script>
  const E = { friction: 0.52, trails: 12, size: 22, dampening: 0.25, tension: 0.93 };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-wand]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    type Node = { x: number; y: number; vx: number; vy: number };
    const pos = { x: -200, y: -200 };
    let lines: { spring: number; friction: number; nodes: Node[] }[] = [];

    // Matiz oscilando em torno do roxo (278°).
    let phase = Math.random() * Math.PI * 2;
    const hue = () => {
      phase += 0.0025;
      return Math.round(278 + Math.sin(phase) * 25);
    };

    const initLines = () => {
      lines = Array.from({ length: E.trails }, (_, i) => ({
        spring: 0.46 + (i / E.trails) * 0.04 + (0.06 * Math.random() - 0.03),
        friction: E.friction + (0.01 * Math.random() - 0.005),
        nodes: Array.from({ length: E.size }, () => ({ x: pos.x, y: pos.y, vx: 0, vy: 0 })),
      }));
    };

    const updateLine = (line: (typeof lines)[number]) => {
      let spring = line.spring;
      const head = line.nodes[0];
      head.vx += (pos.x - head.x) * spring;
      head.vy += (pos.y - head.y) * spring;
      line.nodes.forEach((cur, i) => {
        if (i > 0) {
          const prev = line.nodes[i - 1];
          cur.vx += (prev.x - cur.x) * spring + prev.vx * E.dampening;
          cur.vy += (prev.y - cur.y) * spring + prev.vy * E.dampening;
        }
        cur.vx *= line.friction;
        cur.vy *= line.friction;
        cur.x += cur.vx;
        cur.y += cur.vy;
        spring *= E.tension;
      });
    };

    const drawLine = ({ nodes }: (typeof lines)[number]) => {
      ctx.beginPath();
      ctx.moveTo(nodes[0].x, nodes[0].y);
      for (let i = 1; i < nodes.length - 2; i++) {
        const a = nodes[i];
        const b = nodes[i + 1];
        ctx.quadraticCurveTo(a.x, a.y, (a.x + b.x) / 2, (a.y + b.y) / 2);
      }
      const a = nodes[nodes.length - 2];
      const b = nodes[nodes.length - 1];
      ctx.quadraticCurveTo(a.x, a.y, b.x, b.y);
      ctx.stroke();
    };

    const render = () => {
      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      ctx.globalCompositeOperation = 'lighter';
      ctx.strokeStyle = `hsla(${hue()}, 95%, 68%, 0.45)`;
      ctx.shadowColor = 'rgba(192, 132, 252, 0.85)';
      ctx.shadowBlur = 12;
      ctx.lineWidth = 3.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      for (const line of lines) {
        updateLine(line);
        drawLine(line);
      }
      requestAnimationFrame(render);
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const onMove = (e: MouseEvent | TouchEvent) => {
      const p = 'touches' in e ? e.touches[0] : e;
      if (!p) return;
      pos.x = p.clientX;
      pos.y = p.clientY;
    };

    const onFirstMove = (e: MouseEvent | TouchEvent) => {
      onMove(e);
      initLines();
      document.removeEventListener('mousemove', onFirstMove);
      document.removeEventListener('touchstart', onFirstMove);
      document.addEventListener('mousemove', onMove, { passive: true });
      document.addEventListener('touchmove', onMove, { passive: true });
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('mousemove', onFirstMove, { passive: true });
    document.addEventListener('touchstart', onFirstMove, { passive: true });
    render();
  }
</script>
