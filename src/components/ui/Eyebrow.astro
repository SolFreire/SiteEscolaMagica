---
import Icon from './Icon.astro';

interface Props {
  text: string;
  center?: boolean;
}

const { text, center = false } = Astro.props;
---

<p class:list={['eyebrow', { center }]}>
  <Icon name="sparkle" class="eyebrow-icon" />
  <span>{text}</span>
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-s);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .center {
    justify-content: center;
  }
  .eyebrow :global(.eyebrow-icon) {
    flex: none;
    color: var(--detail);
  }
</style>
