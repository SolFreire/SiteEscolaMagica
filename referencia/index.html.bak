  	overflow: visible !important;
  	overflow-y: clip !important;
  }
</style></div></section><section class="section_statement" style="--height: 100vh; --range: contain 30% exit 30%;"><div class="statement_content-wrapper"><div><h1 class="heading text-size-small" data-wf--global-heading--size="default">Korowa Anglican Girls’ School, located in Glen Iris, Melbourne, is a leading independent school for girls from Prep to Year 12, with a co-educational Early Learning Centre (ELC) program.</h1></div><p class="statement_text-wrap">Discover an <em>outstanding education</em> in a <em>caring community</em>. Korowa students flourish academically, socially and personally... <em>ready to take on the world</em>. </p></div><div class="component-style w-embed"><style>
  /**
  * ANIMATION
  * Text Gradient Fill on Scroll
  * CSS added here because scroll-timeline polyfill only works with styles from same domain and Webflow CSS is on a separate domain
  */
  .section_statement {
    --height: 100vh;
    --range: contain 30% exit 30%;
    view-timeline: --_text-gradient-scrub;
  }
  .text-gradient-fill {
    background-size: 0% 100%;
    background-repeat: no-repeat;
    background-image: linear-gradient(90deg, var(--_theme---text) 90%, transparent);
    animation: text-gradient-color-fill linear both;
    animation-timeline: --_text-gradient-scrub;
    animation-range: var(--range);
  }

  @keyframes text-gradient-color-fill {
    from { background-size: 0% 100%; }
    to { background-size: 110% 100%; }
  }

  /*
  .statement_text-highlight-wrap::after {
  content: '';
  position: absolute;
  inset: auto 0 0 0;
  height: 0.05em;
  background-color: currentColor;
  scale: 0 1;
  transform-origin: left;
  transition: scale 0.5s ease-out;
  }
  .statement_text-highlight-wrap:is(:hover, :focus)::after {
  scale: 1 1;
  }
  */

  .statement_text-highlight-wrap:has(.statement_highlight-image) {
    --underline-height: 0.05em;
    display: inline;
    background-image: linear-gradient(120deg, currentColor 0%, currentColor 100%);
    background-repeat: no-repeat;
    background-size: 0% var(--underline-height);
    background-position: left bottom;
    transition: background-size 0.5s var(--animation--ease);
    cursor: pointer;
  }
  .statement_text-highlight-wrap:is(:hover, :focus) {
    background-size: 100% var(--underline-height);
  }

  .statement_highlight-images-list {
    --angle: 150deg;
  }
  .statement_highlight-image-wrap {
    --i: 1;
    --radius: clamp(6rem, 25cqw, 17.5rem);
    --final-angle: calc((360deg / var(--total-images)) * (var(--i) - 1) - var(--angle));
    transition: all 0.5s cubic-bezier(.785, .135, .15, .86);

    &:nth-child(1) { --i: 1; }
    &:nth-child(2) { --i: 2; }
    &:nth-child(3) { --i: 3; }
  }
  .statement_text-highlight-wrap:is(:hover, :focus) .statement_highlight-image-wrap {
    left: calc(cos(var(--final-angle)) * var(--radius));
    top: calc(sin(var(--final-angle)) * var(--radius));
    scale: 1;
    rotate: 0deg;
  }

  .statement_text-wrap:has(.statement_text-highlight-wrap:is(:hover, :focus)) > span:not(:hover) {
    opacity: 0.75;
  }
</style></div></section><section class="section_years"><div class="padding-global padding-section-medium"><div class="container-large"><div class="years_component text-align-center"><h2 class="max-width-medium">From first steps to <br/>‍<em>future leaders</em></h2><div class="spacer-2"></div><div class="years_card-list"><a class="years-card_component w-inline-block" href="/learn/early-learning" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">Early Learning</h3><p class="text-size-large text-weight-semibold">Ages 3 &amp; 4</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">Early Learning</p></div><figure class="years-card_image-wrap" style="--pos-x: 50%"><img alt="Smiling young girl in a Korowa school fleece jacket holding onto climbing ropes outdoors." class="years-card_image" loading="lazy" src="assets/74adbc3435ece4d6_6940beab875b958575550d8f_14Jun.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a><a class="years-card_component w-inline-block" href="/learn/junior-school" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">Junior School</h3><p class="text-size-large text-weight-semibold">Prep to Year 6</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">Junior School</p></div><figure class="years-card_image-wrap" style="--pos-x: 30%"><img alt="Smiling schoolgirl wearing glasses and a striped uniform sitting at a desk in a classroom." class="years-card_image" loading="lazy" src="assets/ad5701016d3e6418_69856f950273290b2d4e4da4_4Feb2.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a><a class="years-card_component w-inline-block" href="/learn/senior-school" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">Senior School</h3><p class="text-size-large text-weight-semibold">Years 7 to 12</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">Senior School</p></div><figure class="years-card_image-wrap" style="--pos-x: 50%"><img alt="Young woman with long hair looking up while sitting by a red school locker." class="years-card_image" loading="lazy" src="assets/0b12321b7b48204b_69856f9680dd60cf7a043bd6_4Feb2.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a></div></div></div></div><div class="component-style w-embed"><style>
  .years-card_info-layer {
    transition: grid-template-rows 0.5s var(--animation--ease);
  }

  .years-card_component:has(:hover, :focus-visible) .years-card_info-layer {
    grid-template-rows: 1fr;
  }

  /* Change opacity of other non-hovered cards */
  .years_card-list:has(.years-card_component:hover) .years-card_component:not(:hover) .years-card_image-overlay {
    opacity: 0.4;
  }
</style></div></section><section class="section_testimonial" data-bg-color="1"><div class="display-contents"></div><div class="padding-global padding-section-small"><div class="container-small"><div><div class="testimonial_component w-dyn-list"><div class="display-contents w-dyn-items" role="list"><div class="display-contents w-dyn-item" role="listitem"><p class="testimonial_quote">I’m so glad we decided to send our daughter to Korowa. She went from being a shy, quiet child to one who loves school, feels confident in herself, has great friends and has no fear of putting herself into new situations or trying new things. While Korowa is a school where students excel academically, what makes me most proud is seeing my daughter and her friends grow into kind, grounded young people - confident and comfortable in any environment.</p><div class="spacer-2"></div><div class="testimonial_meta"><img alt="" class="testimonial_image w-dyn-bind-empty" loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg"/><div class="spacer-1"></div><p class="testimonial_name">Senior School Parent</p><p class="w-dyn-bind-empty"></p></div></div></div></div></div></div></div></section><section class="section_academic-excellence" data-confetti=""><div class="padding-global padding-section-large"><div class="container-large"><div class="content-intro_component" data-wf--component-content-intro-heading--variant="two-column-split"><div class="visibility-wrapper display-contents"><div class="line-divider"></div><div class="spacer-1d5"></div></div><div class="content-intro_wrap w-variant-838ca63e-029a-66f5-c08c-a991d72f3e1f"><div class="content-intro_title-wrapper w-variant-838ca63e-029a-66f5-c08c-a991d72f3e1f"><div class="eyebrow_component" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">2025 Academic Results</p></div><h2>Academic <em>excellence </em>and <em>future-ready </em>learning</h2></div><div class="content-intro_desc-wrapper w-variant-838ca63e-029a-66f5-c08c-a991d72f3e1f"><div class="rich-text w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="regular"><p>At Korowa, we take pride in our academic success, consistently ranking among Victoria's top schools. Our supportive environment helps each girl excel, preparing her for higher education and future careers. Our 2025 cohort was no exception. </p></div><div class="display-contents hide-if-empty"></div></div></div></div><div class="steps-stagger_component"><div class="display-contents" slot-accepts="Block / Steps Stagger Item"><div class="display-contents" slot-accepts="Block / Academic Excellence Stat Item"><div class="steps-stagger_item" data-stagger="1" style="translate: none; rotate: none; scale: none; transform: translate(0%, 60%) translate3d(0px, 0px, 0px);"><p class="academic-excellence_number"><span data-el="counter">0</span><span class="hide-if-empty">+</span></p><div class="spacer-0d75"></div><div class="line-divider"></div><div class="spacer-1"></div><p>More than 10% achieved ATARS above 99 </p></div><div class="steps-stagger_item" data-stagger="1" style="translate: none; rotate: none; scale: none; transform: translate(0%, 60%) translate3d(0px, 108px, 0px);"><p class="academic-excellence_number"><span data-el="counter">0.0</span><span class="hide-if-empty"></span></p><div class="spacer-0d75"></div><div class="line-divider"></div><div class="spacer-1"></div><p>Median ATAR</p></div><div class="steps-stagger_item" data-stagger="1" style="translate: none; rotate: none; scale: none; transform: translate(0%, 60%) translate3d(0px, 216px, 0px);"><p class="academic-excellence_number"><span data-el="counter">0</span><span class="hide-if-empty"></span></p><div class="spacer-0d75"></div><div class="line-divider"></div><div class="spacer-1"></div><p>Median study score</p></div></div></div></div><div class="button-group w-variant-7208a691-7fa0-7869-d354-20d393399b57" data-wf--block-button-group--alignment="center"><div class="display-contents" slot-accepts="Element / Button"><div class="display-contents"><div class="button_component" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="primary"><a class="button_link w-inline-block" href="/about/academic-results" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">View Academic Results</p></div></div></div></div></div></div></div></section><section class="section_2-col-info-block" data-bg-color="1" data-wf--section-2-column-text-image--layout="image-left"><div class="padding-global"><div class="container-large"><div class="info-block_component grid"><div class="info-block_text-wrapper is-grid-column-half"><div class="eyebrow_component spacer-1" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">Care that underpins learning</p></div><h2><em>Wellbeing</em></h2><div class="spacer-1d5"></div><div class="rich-text w-variant-bee3f83c-b899-3f1e-43fe-bcf7e1292082 w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="large"><p>Student wellbeing is central to everything we do. Through a proactive, research-informed approach, girls are supported to develop resilience, confidence and strong relationships. Our wellbeing framework ensures students feel known, supported and empowered to flourish academically, socially and emotionally.</p></div><div class="visibility-wrapper"><div class="spacer-2"></div><div class="button-group"><div class="button_component w-variant-81eb97b7-cf50-1c58-61cc-418fd746197b" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="secondary"><a class="button_link w-inline-block" href="/about/student-wellbeing" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">Explore Student Wellbeing</p></div></div><div class="display-contents"></div></div></div></div><div class="info-block_image-wrapper w-variant-78303301-e12d-ef5e-4323-a4f194065dd1 is-grid-column-half"><div class="info-block_image_component" id="" style="--ratio: 1/1"><div class="image-wrapper" data-parallax="1" data-wf--global-visual-image-video--styling-size="16-9" style="--pos-y: 20%; --pos-x: 50%;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="" class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/8f7548c5c0580dc7_69856f943aa0e3e302b1b471_4Feb2.webp" srcset="assets/26807d49764fe971_69856f943aa0e3e302b1b471_4Feb2.webp 500w, assets/8e62fe5feee11e80_69856f943aa0e3e302b1b471_4Feb2.webp 800w, assets/018f2997dea504c2_69856f943aa0e3e302b1b471_4Feb2.webp 1080w, assets/4720cb9cda9e9373_69856f943aa0e3e302b1b471_4Feb2.webp 1600w, assets/8f7548c5c0580dc7_69856f943aa0e3e302b1b471_4Feb2.webp 2000w"/></figure></div></div></div></div></div></div></section><section class="section_2-col-info-block" data-bg-color="1" data-wf--section-2-column-text-image--layout="image-right"><div class="padding-global"><div class="container-large"><div class="info-block_component grid"><div class="info-block_text-wrapper is-grid-column-half"><div class="eyebrow_component spacer-1" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">Learning with depth</p></div><h2><em>Enrichment</em> and Extension</h2><div class="spacer-1d5"></div><div class="rich-text w-variant-bee3f83c-b899-3f1e-43fe-bcf7e1292082 w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="large"><p>Learning at Korowa is designed to stretch every student. Through purposeful enrichment and extension, girls are supported to deepen understanding, explore ideas beyond the curriculum and engage with learning in ways that are challenging, inspiring and responsive to their individual strengths.</p></div><div class="visibility-wrapper"><div class="spacer-2"></div><div class="button-group"><div class="button_component w-variant-81eb97b7-cf50-1c58-61cc-418fd746197b" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="secondary"><a class="button_link w-inline-block" href="/learn/enrichment-extension" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">Explore Enrichment &amp; Extension</p></div></div><div class="display-contents"></div></div></div></div><div class="info-block_image-wrapper is-grid-column-half"><div class="info-block_image_component" id="" style="--ratio: 1/1"><div class="image-wrapper" data-parallax="1" data-wf--global-visual-image-video--styling-size="16-9" style="--pos-y: 50%; --pos-x: 50%;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="" class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/036c9a39e43bc28b_69856f9304f2366d17485ce6_4Feb2.webp" srcset="assets/aebb2127724efd1a_69856f9304f2366d17485ce6_4Feb2.webp 500w, assets/9790645343891487_69856f9304f2366d17485ce6_4Feb2.webp 800w, assets/8aec16901cf958fc_69856f9304f2366d17485ce6_4Feb2.webp 1080w, assets/5e8cdf8e4fc9a6d0_69856f9304f2366d17485ce6_4Feb2.webp 1600w, assets/036c9a39e43bc28b_69856f9304f2366d17485ce6_4Feb2.webp 2000w"/></figure></div></div></div></div></div></div></section><section class="section_cta" data-wf--section-cta--style="card"><div class="padding-global padding-section-medium"><div class="container-large"><div class="cta_component"><div class="circle-blur-wrapper" data-wf--element-blurred-gradient-bg-circle--variant="primary" style="inset: 0 0 auto auto"><div class="circle-blur" style="--opacity: 0.25"></div></div><div class="cta_crest-wrapper"><svg class="logo_crest-mark"><use href="#logo-crest-icon"></use></svg></div><div class="cta_content-wrapper"><div class="eyebrow_component spacer-1d5" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">Applications now open</p></div><h2><em>Apply Now</em></h2><div class="spacer-1d5"></div><p class="hide-if-empty">Your child's journey at Korowa starts here.</p><div class="spacer-2"></div><div class="button-group is-center"><div class="button_component" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="primary"><a class="button_link w-inline-block" href="/enrolments/apply" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">Apply online</p></div></div><div class="display-contents"></div></div></div></div></div></div></section><section class="section_years"><div class="padding-global padding-section-medium"><div class="container-large"><div class="years_component text-align-center"><h2 class="max-width-medium">More to <em>discover</em><br/></h2><div class="spacer-2"></div><div class="years_card-list"><a class="years-card_component w-inline-block" href="/co-curricular/sport" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">Sport</h3><p class="text-size-large text-weight-semibold">‍</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">Sport</p></div><figure class="years-card_image-wrap" style="--pos-x: 50%"><img alt="Smiling girl in red netball uniform holding a Gilbert netball, with teammates in red uniforms huddling in the background indoors." class="years-card_image" loading="lazy" src="assets/730b4194c38da850_692e5ae924c8c68836b5b4d5_17Jun.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a><a class="years-card_component w-inline-block" href="/co-curricular/music" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">Music</h3><p class="text-size-large text-weight-semibold">‍</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">Music</p></div><figure class="years-card_image-wrap" style="--pos-x: 30%"><img alt="Young female violinist in uniform playing violin in an orchestra setting." class="years-card_image" loading="lazy" src="assets/aaa1b5faf670b88e_695c904db20f32a5bf5e3a9c_dsc06.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a><a class="years-card_component w-inline-block" href="/co-curricular/stem-academy" target="_blank"><div class="years-card_info-layer"><div class="years-card_info-content"><div class="years-card_spacer"></div><h3 class="text-color-primary text-style-italic">STEM Academy</h3><p class="text-size-large text-weight-semibold">‍</p><div class="spacer-1"></div></div></div><div class="years-card_title-wrap"><p class="heading-style-h3">STEM Academy</p></div><figure class="years-card_image-wrap" style="--pos-x: 50%"><img alt="Three students wearing safety goggles and gloves closely examine a yellow liquid in a conical flask in a science lab." class="years-card_image" loading="lazy" src="assets/96eb0325011594f7_698575ed0332e19ff98dc4f3_4Feb2.webp"/><div class="years-card_text-overlay"></div><div class="years-card_image-overlay"></div></figure></a></div></div></div></div><div class="component-style w-embed"><style>
  .years-card_info-layer {
    transition: grid-template-rows 0.5s var(--animation--ease);
  }

  .years-card_component:has(:hover, :focus-visible) .years-card_info-layer {
    grid-template-rows: 1fr;
  }

  /* Change opacity of other non-hovered cards */
  .years_card-list:has(.years-card_component:hover) .years-card_component:not(:hover) .years-card_image-overlay {
    opacity: 0.4;
  }
</style></div></section><section class="section_card-stack" id="" style="--gradient-size: 100vw"><div class="padding-global padding-section-medium"><div class="container-large"><div class="card-stack_component"><div class="card-stack_content max-width-large"><div class="content-intro_component" data-wf--component-content-intro-heading--variant="centered"><div class="content-intro_wrap"><div class="content-intro_title-wrapper"><h2><em>Lead </em>with purpose. <em>Inspire </em>change.</h2></div><div class="content-intro_desc-wrapper"><div class="rich-text w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="regular"><p>Korowa aims to empower students to develop their own leadership identity, preparing them for roles as future leaders. From Junior School onwards, students engage in both formal and informal opportunities to enhance their leadership experience and capacity.</p></div><div class="display-contents hide-if-empty"><div class="button_component" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="primary"><a class="button_link w-inline-block" href="/co-curricular" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">Co-curricular opportunities</p></div></div></div></div></div></div></div><div class="card-stack_cards-list" data-columns="3" slot-accepts="Component / Card Stack - Card Item"><div class="card-stack_card" data-wf--component-card-stack---card-item--variant="white" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate3d(0px, 0px, 0px);"><div class="card-stack_card_icon-wrapper"><span aria-hidden="true" class="icon_content w-variant-e23a2752-5a66-82d5-e82b-ecdcd70739f4" data-wf--global-content-icon--icon="plant" style="--width: 100%;"></span></div><h4 class="card-stack_title">Early leadership foundations</h4><div class="rich-text w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="regular"><p>In Junior School, students develop good character through leadership, encouraging initiative and embracing Korowa's values of courage, respect and integrity. Year 6 students take on formal leadership roles like Junior School Co-Captains and Portfolio Captains.</p></div></div><div class="card-stack_card" data-wf--component-card-stack---card-item--variant="white" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate3d(0px, 0px, 0px);"><div class="card-stack_card_icon-wrapper"><span aria-hidden="true" class="icon_content w-variant-00e72734-ea9b-909f-77cc-1543949b9707" data-wf--global-content-icon--icon="star" style="--width: 100%;"></span></div><h4 class="card-stack_title">Building influence</h4><div class="rich-text w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="regular"><p>Year 9 students can become Ambassadors, welcoming future families to the school. In Year 10, students with strong leadership interest can participate in the Peer Support Program, working with Year 7 students after a formal training program from the Australian Government’s Department of Health. Students 14 and over can participate in the international Duke of Edinburgh Awards, encouraging leadership and service. </p></div></div><div class="card-stack_card" data-wf--component-card-stack---card-item--variant="white" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate3d(0px, 0px, 0px);"><div class="card-stack_card_icon-wrapper"><span aria-hidden="true" class="icon_content w-variant-ac2f390a-8835-d68c-fd93-46e4b7aa6e93" data-wf--global-content-icon--icon="globe" style="--width: 100%;"></span></div><h4 class="card-stack_title">Leadership and impact</h4><div class="rich-text w-richtext" data-columns="1" data-wf--global-rich-text-text-image--text-size="regular"><p>Year 11 students can nominate as House Representatives and collaborate with their Mentor and Head of Year. They are encouraged to join leadership groups like the Student Representative Council (SRC) and apply for Year 12 leadership roles, focusing on initiatives that support scholarships for girls in Timor L’este and resources for schools in Bangladesh.</p></div></div></div></div></div></div><div class="circle-blur-wrapper" data-wf--element-blurred-gradient-bg-circle--variant="primary" style="inset: 0 0 auto auto"><div class="circle-blur" style="--opacity: 0.25"></div></div><div class="circle-blur-wrapper" data-wf--element-blurred-gradient-bg-circle--variant="secondary" style="inset: auto auto 50% 0"><div class="circle-blur w-variant-0eb8a020-8bb1-91f3-764e-8d455963d820" style="--opacity: 0.25; --gradient-size: 100vw;"></div></div></section><section class="section_image-cloud"><div class="image-cloud_content-wrapper"><div class="eyebrow_component" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">Korowa Experiences</p></div><h2 class="margin-bottom margin-xsmall"><em>Exceptional</em> <em>education</em>. <br/>Inside and <em>outside</em> the classroom</h2><div class="button_component" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="primary"><a class="button_link w-inline-block" href="/co-curricular/outdoor-camps-international" target="_blank"></a><div class="button_bg-hover"></div><div class="button_content-wrapper" data-icon-position="1"><p class="button_text">Camps &amp; International</p></div></div></div><div class="image-cloud_scroll"><div class="image-cloud_center-image-sticky-wrap"><div class="image-cloud_center-image-wrap"><img alt="Group of hikers with large backpacks walking on a forest trail illuminated by sunlight rays." class="image-cloud_center-image" loading="lazy" sizes="100vw" src="assets/df0ffd26fd945aed_68e64b67c0fe4ea85c8ae514_heade.webp" srcset="assets/8ddb61091eb10eb8_68e64b67c0fe4ea85c8ae514_heade.webp 500w, assets/63e4bbb6221a38a7_68e64b67c0fe4ea85c8ae514_heade.webp 800w, assets/816e3390fd256c1c_68e64b67c0fe4ea85c8ae514_heade.webp 1080w, assets/2a024fbb6dc8a184_68e64b67c0fe4ea85c8ae514_heade.webp 1600w, assets/df0ffd26fd945aed_68e64b67c0fe4ea85c8ae514_heade.webp 1920w"/><img alt="" class="image-cloud_center-image" data-safari-avif-hide="" loading="lazy" src="assets/490b786a75d62670_68de0af581d18e32eed157c0_d15ba.avif"/><div class="image_scroll-overlay"></div></div></div><div class="image-cloud_image-wrap is-1" style="--speed: -20vh"><div class="image-wrapper w-variant-c428d57e-eeb9-cecb-862f-efe1b8e0c69f" data-parallax="0" data-wf--global-visual-image-video--styling-size="square" style="--pos-y: 50%; --pos-x: 50%; --ratio: 16/9;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="Group of seven young women wearing winter clothing posing in front of a snow-covered castle and trees." class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/e47f0c7887a04c4e_695e1153f363b6e8fdbe3525_Image.webp" srcset="assets/2d2f0ce07199ad2e_695e1153f363b6e8fdbe3525_Image.webp 500w, assets/98fa49f9119873ad_695e1153f363b6e8fdbe3525_Image.webp 800w, assets/0ff63a5d916c3c9f_695e1153f363b6e8fdbe3525_Image.webp 1080w, assets/2e1d0f2ffb8a3f24_695e1153f363b6e8fdbe3525_Image.webp 1600w, assets/e47f0c7887a04c4e_695e1153f363b6e8fdbe3525_Image.webp 2000w"/></figure></div></div><div class="image-cloud_image-wrap is-2" style="--speed: -50vh"><div class="image-wrapper w-variant-a340da74-3aac-35b0-169e-a61c9261f764" data-parallax="0" data-wf--global-visual-image-video--styling-size="custom" style="--pos-y: 50%; --ratio: 4/3;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="" class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/5a41af3eadc31424_6940bea0d703d2cbdeda4864_10thO.webp" srcset="assets/1db0c094a68a64a8_6940bea0d703d2cbdeda4864_10thO.webp 500w, assets/6663be56b96061bb_6940bea0d703d2cbdeda4864_10thO.webp 800w, assets/81d67d6841f38bf8_6940bea0d703d2cbdeda4864_10thO.webp 1080w, assets/21662f0fe630ff58_6940bea0d703d2cbdeda4864_10thO.webp 1600w, assets/5a41af3eadc31424_6940bea0d703d2cbdeda4864_10thO.webp 2000w"/></figure></div></div><div class="image-cloud_image-wrap is-3" style="--speed: -60vh"><div class="image-wrapper" data-parallax="0" data-wf--global-visual-image-video--styling-size="16-9" style="--pos-y: 50%; --pos-x: 50%; --ratio: 16/9;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="Three young women smiling and holding signs that say 'MATE ROV COMPETITION' and '#watergame' against a blue MATE ROV backdrop." class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/72d2cce12bfd09a7_695d92ecf08a7c682a9d82e2_Image.webp" srcset="assets/e7b10f993378f7bd_695d92ecf08a7c682a9d82e2_Image.webp 500w, assets/00b4cb9503658029_695d92ecf08a7c682a9d82e2_Image.webp 800w, assets/58dbbf0ca55159a1_695d92ecf08a7c682a9d82e2_Image.webp 1080w, assets/83107703b89f393c_695d92ecf08a7c682a9d82e2_Image.webp 1600w, assets/72d2cce12bfd09a7_695d92ecf08a7c682a9d82e2_Image.webp 2000w"/></figure></div></div><div class="image-cloud_image-wrap is-4" style="--speed: -30vh"><div class="image-wrapper" data-parallax="0" data-wf--global-visual-image-video--styling-size="16-9" style="--pos-y: 50%; --pos-x: 50%; --ratio: 16/9;"><div class="image-overlay-layer" style="--opacity: 0"></div><figure><img alt="Group of young people outdoors looking up, one woman using binoculars in a wooded area." class="image" loading="lazy" sizes="(max-width: 2000px) 100vw, 2000px" src="assets/61d4920141dc45b6_695df80b469624c8b05e1a2d_11Nov.webp" srcset="assets/311ef18031244fb8_695df80b469624c8b05e1a2d_11Nov.webp 500w, assets/9e2f44a03b89a37d_695df80b469624c8b05e1a2d_11Nov.webp 800w, assets/1e864829d067bf64_695df80b469624c8b05e1a2d_11Nov.webp 1080w, assets/5c1289b21fac8e48_695df80b469624c8b05e1a2d_11Nov.webp 1600w, assets/61d4920141dc45b6_695df80b469624c8b05e1a2d_11Nov.webp 2000w"/></figure></div></div></div><div class="component-style w-embed"><style>
  .image-cloud_scroll {
    view-timeline-name: --image-cloud-timeline;
    view-timeline-axis: block;
  }

  .image-cloud_center-image-wrap {
    animation: cloud-scroll_center-image-scale-in ease-out both;
    animation-timeline: --image-cloud-timeline;
    animation-range: contain 5% contain 85%;
  }

  .image-cloud_image-wrap {
    --speed: -50vh;
    animation: cloud-scroll_side-image-parallax ease-out both;
    animation-timeline: --image-cloud-timeline;
    animation-range: contain 0% contain 100%;
  }

  .image-cloud_scroll .image_scroll-overlay {
    animation: cloud-scroll_show-overlay ease-out both;
    animation-timeline: --image-cloud-timeline;
    animation-range: contain 5% contain 85%;
  }

  @keyframes cloud-scroll_center-image-scale-in {
    from {
      transform: scale(0.3);
      height: 80%;
    }
    15% {
      height: 100%;
      transform: scale(0.3);
    }
    to {
      transform: scale(1, 1);
    }
  }

  @keyframes cloud-scroll_side-image-parallax {
    from { translate: 0 0vh; }
    to { translate: 0 var(--speed); }
  }

  @keyframes cloud-scroll_show-overlay {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style></div></section><section class="section_latest-news"><div class="padding-global padding-section-small"><div class="container-large"><div class="latest-news_header-wrap"><div class="eyebrow_component" data-wf--element-eyebrow--layout="horizontal"><div class="eyebrow_icon"><span aria-hidden="true" class="icon_svg" data-wf--global-general-icon--icon="flower" style=""></span></div><p class="text-style-eyebrow">News &amp; Events</p></div><div class="spacer-1d5"></div><h2><em>News </em>from Korowa</h2></div><div class="spacer-4"></div><div class="latest-news_component" data-slider-effect="cards" data-slider-el="component" data-slider-loop="true"><div class="latest-news_slider_component swiper w-dyn-list swiper-cards swiper-3d swiper-initialized swiper-horizontal swiper-watch-progress"><div aria-live="polite" class="latest-news_slider_wrapper swiper-wrapper w-dyn-items" id="swiper-wrapper-cd96ed10285659424" role="list" style="transition-duration: 0ms; transition-delay: 0ms; transform: translateX(653px);"><div aria-label="1 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item swiper-slide-visible swiper-slide-fully-visible is-active" role="group" style="transition-duration: 0ms; z-index: 8; transform: translate3d(0px, 0px, 0px) rotateZ(0deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/advice-on-international-university-pathways"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/e3779ac168961bbc_6a72b8d4da79dac1d956eea2_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#5ac5c9">Education</p><p>Jul 17, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">How Korowa prepares students for international university pathways</h3><div class="spacer-0d5"></div><p class="news_card_summary">Discover how Korowa's expert careers guidance and global university connections help students navigate UK university applications and international university pathways with confidence.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 0; transition-duration: 0ms;"></div></div><div aria-label="2 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item swiper-slide-visible swiper-slide-fully-visible is-next" role="group" style="transition-duration: 0ms; z-index: 7; transform: translate3d(calc(56.85% - 504px), 0px, -100px) rotateZ(2deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/annas-global-learning-journey"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/0bea149095aa6f57_6a72b8d4da79dac1d956eeb7_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#5ac5c9">Education</p><p>Jul 6, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">From Future Problem Solving to Harvard: Anna's Global Learning Journey</h3><div class="spacer-0d5"></div><p class="news_card_summary">Year 10 student Anna, represented Australia at the FPS Finals in the States and participated in a Harvard University Program.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="3 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item swiper-slide-visible" role="group" style="transition-duration: 0ms; z-index: 6; transform: translate3d(calc(112.2% - 1008px), 0px, -200px) rotateZ(4deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/stem-in-korowas-junior-school"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/b5afbc9550efc2a5_6a72b8d4da79dac1d956eeae_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#5ac5c9">Education</p><p>Jul 3, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">Where curiosity becomes capability: STEM in Korowa's Junior School</h3><div class="spacer-0d5"></div><p class="news_card_summary">Junior School students are encouraged to ask questions today, so they are prepared to solve tomorrow's challenges.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="4 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item" role="group" style="transition-duration: 0ms; z-index: 5; transform: translate3d(calc(166.05% - 1512px), 0px, -300px) rotateZ(6deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/cross-school-maths-learning"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/adbb33c855cbf860_6a72b8d4da79dac1d956eec5_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#5ac5c9">Education</p><p>Jul 1, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">How hands-on maths lessons build confidence, leadership and real-world skills</h3><div class="spacer-0d5"></div><p class="news_card_summary">A collaborative maths lesson where Year 4 and Year 8 students explored real-world problem solving, leadership, and learning together.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="5 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item" role="group" style="transition-duration: 0ms; z-index: 4; transform: translate3d(calc(218.4% - 2016px), 0px, -400px) rotateZ(8deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/school-captains-reunion"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" sizes="100vw" src="assets/54065c66f403631c_6a7aa050384548c8c7e45e15_schoo.jpg" srcset="assets/2df5b3b41c19c9dd_6a7aa050384548c8c7e45e15_schoo.jpg 500w, assets/eb848960987c9124_6a7aa050384548c8c7e45e15_schoo.jpg 800w, assets/a94e419da9a98987_6a7aa050384548c8c7e45e15_schoo.jpg 1080w, assets/f917787a8f629e8d_6a7aa050384548c8c7e45e15_schoo.jpg 1600w, assets/54065c66f403631c_6a7aa050384548c8c7e45e15_schoo.jpg 1920w"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#8aa1ff">Alumni</p><p>Jun 15, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">A Century of Girls’ Leadership</h3><div class="spacer-0d5"></div><p class="news_card_summary">More than a century of student leadership came together at Korowa as former and current School Captains and Deputies connected across generations at this reunion.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="6 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item" role="group" style="transition-duration: 0ms; z-index: 3; transform: translate3d(calc(218.4% - 2520px), 0px, -400px) rotateZ(8deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/preparing-for-stem-racing-state-final"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/c7c72869fba338ad_6a72b8d4da79dac1d956eea5_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#b487ce">School News</p><p>Jun 10, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">STEM Racing at Korowa: How students are preparing for the Victorian State Final</h3><div class="spacer-0d5"></div><p class="news_card_summary">Year 8 and 9 students competed in Korowa's internal STEM Racing selection event, putting months of engineering, design thinking, and collaboration to the test. </p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="7 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item" role="group" style="transition-duration: 0ms; z-index: 2; transform: translate3d(calc(218.4% - 3024px), 0px, -400px) rotateZ(8deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/year-3-letter-writing-project-literacy-skills"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/a94f06f84dc46bfc_6a72b8d3da79dac1d956ee8e_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#5ac5c9">Education</p><p>Jun 5, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">Building literacy skills through authentic learning in Junior School</h3><div class="spacer-0d5"></div><p class="news_card_summary">How a Year 3 letter writing project sparked a love of learning</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div><div aria-label="8 / 8" class="latest-news_slider_slide swiper-slide w-dyn-item" role="group" style="transition-duration: 0ms; z-index: 1; transform: translate3d(calc(218.4% - 3528px), 0px, -400px) rotateZ(8deg) scale(1); margin-right: 24px;"><a class="news_card_component w-inline-block" href="/post/family-affair-at-our-legally-blonde-jr-production"><div class="overflow-clip"><img alt="" class="news_card_image" loading="lazy" src="assets/0ab24d5243cba62e_6a72b8d4da79dac1d956eecb_6a72b.webp"/></div><div class="news_card_meta-wrap"><p class="news_card_category" style="background-color:#b487ce">School News</p><p>Jun 3, 2026</p></div><div class="news_card_content-wrap"><h3 class="news_card_title">Family Affair at our Legally Blonde Jr. Production</h3><div class="spacer-0d5"></div><p class="news_card_summary">A starring role in Legally Blonde Jr. became a celebration of family, community, and a remarkable Korowa connection spanning four generations and more than 70 years.</p></div></a><div class="swiper-slide-shadow swiper-slide-shadow-cards" style="opacity: 1; transition-duration: 0ms;"></div></div></div><span aria-atomic="true" aria-live="assertive" class="swiper-notification"></span></div><div class="slider_nav-wrap"><button aria-disabled="true" aria-label="Previous slide" class="slider_nav is-disabled" data-slider-el="nav-prev" disabled="" tabindex="-1"><span aria-hidden="true" class="icon_svg w-variant-617369d3-7f15-e28e-086f-2519faaf713f" data-wf--global-general-icon--icon="arrow-left" style=""></span></button><div class="slider_pagination-wrap swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal" data-slider-el="pagination"><button aria-current="true" aria-label="Go to slide 1" class="slider_pagination-bullet is-active" tabindex="0"></button><button aria-label="Go to slide 2" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 3" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 4" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 5" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 6" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 7" class="slider_pagination-bullet" tabindex="0"></button><button aria-label="Go to slide 8" class="slider_pagination-bullet" tabindex="0"></button></div><button aria-label="Next slide" class="slider_nav" data-slider-el="nav-next" tabindex="0"><span aria-hidden="true" class="icon_svg w-variant-dc0bb6e3-9751-5653-6992-a53ae564efab" data-wf--global-general-icon--icon="arrow-right" style=""></span></button></div><div class="button_component w-variant-81eb97b7-cf50-1c58-61cc-418fd746197b" data-link-fill-parent="0" data-size="1" data-wf--element-button--type="secondary"><a class="button_link w-inline-block" href="/resources/blog"></a><div class="button_bg-hover"></div><div 