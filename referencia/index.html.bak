</style></div><div class="w-embed"><style>
  /* Font anti-aliasing */
  * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -o-font-smoothing: antialiased;
  }

  html {
    scroll-padding-top: var(--anchor-scroll-offset, 5rem);
  }

  /* Remove default margin in favour of better control in authored CSS */
  body, h1, h2, h3, h4, h5, h6, p,
  figure, blockquote, dl, dd {
    margin-block-start: 0;
    margin-block-end: 0;
  }

  button, input {
    line-height: 1.1;
  }

  button {
    background-color: unset;
    padding: unset;
    text-align: inherit;
  }

  /* Don't wait for second tap action for links and buttons. Makes interactions 300ms faster */
  a, button {
    touch-action: manipulation;
  }

  /* Inherit fonts for inputs and buttons */
  input, button,
  textarea, select {
    font-family: inherit;
    font-size: inherit;
  }

  /* To avoid input zoom in on iphone */
  input,
  .w-input, .w-select {
    font-size: clamp(16px, 1rem, 18px);
  }

  /* Anything that has been anchored to should have extra scroll margin */
  :target {
    scroll-margin-block: 5ex;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Animate keyboard focus outline */
    :focus-visible {
      transition: outline-offset .25s ease;
      outline-offset: 3px;
    }
  }

  blockquote::before {
    content: "";
    mask: var(--_icon---open-quote) center / contain no-repeat;
    width: 2em;
    height: 2em;
    background-color: var(--_theme---detail--primary);
    display: inline-block;
    margin-right: 0.5rem;
  }

  /* Make sure textareas without a rows attribute are not tiny */
  textarea:not([rows]) {
    min-height: 10em;
  }

  section {
    position: relative;
    /* Theme vars */
    background-color: var(--_theme---background);
    color: var(--_theme---text);
    transition: background 200ms ease, color 200ms ease;
  }
  section[data-full-width="1"] {
    padding-inline: 0;
  }
  section[data-full-width="1"] .container {
    max-width: 0;
  }
  section[data-bg-color="2"] {
    background-color: var(--_theme---background-secondary);
  }

  details > summary {
    cursor: pointer;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {   /* Firefox */
    content: none;
  }

  /**
  * Dialog element, used for lightbox modals
  */
  dialog[open] {
    display: flex;
    opacity: 1;
  }
  dialog {
    --_backdrop-color: rgba(0, 0, 0, 0.5);
    --_transition-duration: 0.4s;
    opacity: 0;
    border: 0;
    padding: 0;
    margin: 0;
    max-width: none;
    max-height: none;
    background-color: transparent;
    transition: 
      overlay var(--_transition-duration) ease-out allow-discrete,
      display var(--_transition-duration) ease-out allow-discrete,
      opacity var(--_transition-duration) ease-out;
    overscroll-behavior: none;
  }
  dialog::backdrop {
    background-color: transparent;
    backdrop-filter: blur(6px);
    transition:
      display var(--_transition-duration) allow-discrete,
      overlay var(--_transition-duration) allow-discrete,
      background-color var(--_transition-duration);
  }
  dialog[open]::backdrop {
    background-color: var(--_backdrop-color); 
  }

  @starting-style {
    dialog[open] {
      opacity: 0;
    }
    dialog[open]::backdrop {
      background-color: transparent;
    }
  }
  /* For webflow designer view where backdrop doesn't show on adding [open] */
  html.wf-design-mode dialog[open] {
    background-color: var(--_backdrop-color);
  }

  /*
  * Details accordions
  */
  html:not(.wf-design-mode) details summary > * {
    /* Make entire summary area toggle-able */
    pointer-events: none;
  }

  /**
  * Table
  */
  .w-richtext:has(table) {
    width: 100%;
  }
  table {
    border: 1px solid var(--_theme---border);
    border-radius: 0.5rem;
    overflow: hidden;
    width: 100%;
  }
  td, th {
    border: 1px solid var(--_theme---border);
    padding: 1rem;
  }
  th {
    background-color: var(--_color---white);
    border-top: 0;
  }
  tr:first-child,
  th:first-child {
    border-left: 0;
  }
  tr:last-child,
  th:last-child {
    border-right: 0;
  }

  /* Set color style to inherit */
  .inherit-color * {
    color: inherit;
  }

  /* Focus state style for keyboard navigation for the focusable elements */
  *[tabindex]:focus-visible,
  input[type="file"]:focus-visible {
    outline: 0.125rem solid #4d65ff;
    outline-offset: 0.125rem;
  }

  /* Get rid of top margin on first element in any rich text element */
  .w-richtext > :not(div):first-child, .w-richtext > div:first-child > :first-child {
    margin-top: 0 !important;
  }

  /* Get rid of bottom margin on last element in any rich text element */
  .w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
    margin-bottom: 0 !important;
  }

  /* Stretching rich-text media to full width on mobile landscape and below */
  @media screen and (max-width: 767px) {
    .w-richtext figure.w-richtext-align-center {
      max-width: 100%;
    }
    .w-richtext figure.w-richtext-figure-type-video {
      width: 100%;
      padding-bottom: 56.25% !important;
    }
  }

  /* Reset default Webflow slider heights from absolute numbers to auto */
  .w-slider, .w-slider-nav {
    height: auto;
  }

  /* Override native webflow lightbox sizing */
  .w-lightbox-figure {
    width: 90vw;
    aspect-ratio: 16 / 9;
    max-height: 90vh;
  }

  /* Create a class of .div-square which maintains a 1:1 dimension of a div */
  .div-square::after {
    content: "";
    display: block;
    padding-bottom: 100%;
  }

  /* Make sure containers never lose their center alignment */
  .container-medium,.container-small, .container-large {
    margin-right: auto !important;
    margin-left: auto !important;
  }

  /* Apply "..." after 3 lines of text */
  .text-style-3lines {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  /* Apply "..." after 2 lines of text */
  .text-style-2lines {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Apply "..." at 100% width */
  .truncate-width { 
    width: 100%; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
  }
  /* Removes native scrollbar */
  .no-scrollbar {
    -ms-overflow-style: none;
    overflow: -moz-scrollbars-none; 
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .form_input.is-select-input {
    background-position: right 1rem center;
  }

  html:not(.wf-design-mode) .live-pointer-events-none {
    pointer-events: none;
  }

  html:not(.wf-design-mode) .hide-on-live-site {
    display: none;
  }

  .hide-if-empty:empty {
    display: none;
  }

  a.hide-if-empty-link:is([href="#"], [href=""]) {
    display: none;
  }

  /* Hide marked animated AVIF on safari before v26 - to avoid lag */
  @supports (not (animation-timeline: view())) and (not (-moz-appearance: none)) {
    img[data-safari-avif-hide][src*=".avif"] {
      display: none !important;
    }
  }

  .rich-text ul li {
    list-style: none; 
    position: relative;
  }
  .rich-text ul li::before {
    content: "";
    position: absolute;
    display: inline-block;
    vertical-align: middle;
    left: -1em;
    top: 3px;
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    mask-image: var(--_icon---flower);
    width: 1em;
    height: 1em;
    background-color: var(--_theme---detail--primary);
  }
  
  .w-richtext ol, .w-richtext ul {
    overflow: visible !important;
}
</style></div><div class="w-embed"><style>
/**
 * Grid system variables
 */
:root {
	--_grid---column-width: calc((min(var(--container--large), (100vw - (var(--page-padding) * 2))) - (var(--_grid---column-count) - 1) * var(--_grid---column-gap)) / var(--_grid---column-count));
}
 
.grid-full-width {
	--_grid---column-total-gap: calc( var(--_grid---column-gap) * (var(--_grid---column-count) - 1) );
  --_grid---edge-gutter: minmax( calc(var(--page-padding) - var(--_grid---column-gap)), 1fr );
  --_grid---container-columns: 
  	minmax(
    	0px, 
      calc(
      	(var(--container--large) - var(--_grid---column-total-gap)) / 
        var(--_grid---column-count) 
    	)
    );
	grid-template-columns: 
      [full-width-start] 
      	var(--_grid---edge-gutter) 
        [container-start] 
        	repeat( var(--_grid---column-count), var(--_grid---container-columns) )
    		[container-end]
      	var(--_grid---edge-gutter)
    	[full-width-end];
}
</style></div><div class="w-embed"><style>
  /* Add the site components styling here.
  * Anything that isn't for global site elements
  */

  /* Buttons */
  .button_component:not([data-link-fill-parent="1"]):has(.button_link:active) {
    transform: scale(0.96);
  }
  .button_bg-hover {
    --opacity-duration: 0.3s;
    transition: opacity var(--opacity-duration) ease, transform 0s var(--opacity-duration); /* transform delay to finish opacity */
  }
  .button_component:not([data-link-fill-parent="1"]) .button_link:is(:hover, :focus-visible) + .button_bg-hover {
    transform: scale(1);
    opacity: 1;
    transition: transform 0.35s var(--animation--ease); 
  }
  .button_component[data-wf--button-element--type="link"] .button_content-wrapper {
    padding: 0.25rem 0;
  }
  .button_component:has(.button_link:hover, .button_link:focus-visible) .button_icon-wrapper {
    transform: translateX(0.25rem);
  }
  .button_component[data-size="0"] .button_content-wrapper {
    padding: var(--_space---0-5) var(--_space---1);
    font-size: 0.9em;
  }
  .button_component[data-size="2"] .button_content-wrapper {
    padding: var(--_space---0-75) var(--_space---1-75);
    font-size: 1.1em;
  }
  .button_component[data-link-fill-parent="1"] {
    position: static;
  }
  .button_content-wrapper[data-icon-position="0"] .button_icon-wrapper {
    order: -1;
  }
    [data-wf--element-button--type="link"][data-size="0"] {
    justify-content: flex-start;
    --_theme---button-link--text-hover: currentColor;
  }
    [data-wf--element-button--type="link"][data-size="0"] .button_content-wrapper {
    padding: 0;
  }
  [data-wf--element-button--type="link"][data-size="0"] .button_bg-hover {
    display: none;
  }
  
  .news_card_right .button_content-wrapper {
  	padding-left: 0;
  }

  /* Rich Text */
  @media screen and (min-width: 768px) {
    .rich-text[data-columns="2"] {
      columns: 2;
      column-gap: var(--_grid---column-gap);
    }
    .rich-text :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote) {
      break-inside: avoid;
    }
  }

  /* Eyebrow */
  .eyebrow_component:has(.text-style-eyebrow:empty) {
    display: none;
  }

  /* Breadcrumbs - select links which have visible links following them */
  .breadcrumb-link .icon_svg {
    display: none;
  }
  .breadcrumb-link:not(.w-condition-invisible):has(~ .breadcrumb-link:not(.w-condition-invisible)) .icon_svg {
    display: inline-flex;
    margin-left: 0.5rem;
  }

  /*
  * Link Hover Underline
  */
  [data-hover-underline] {
    position: relative;
    overflow: clip;
  }
  [data-hover-underline]::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    bottom: 0.3em;
    left: 0;
    height: 0.05em;
    width: 100%;
    translate: -101% 0%;
    transition: translate 250ms ease-out;
  }
  [data-hover-underline]:is(:hover, :focus)::after {
    translate: 0% 0%;
  }
.nav-menu_link-group-tab_links [data-hover-underline].w--current::after {
  transform: translateX(0);
  transition: none;
}


  [data-current-link] {
    position: relative;
  }
  [data-current-link][data-copied="true"]::after {
    content: "Copied";
    padding: 0.25rem 0.5rem 0.25rem 0.5rem;
    position: absolute;
    top: -0.25rem;
    background-color: black;
    color: white;
    font-weight: 500;
    font-size: 0.875rem;
    border-radius: 0.25rem;
    transform: translate(0%, -100%);
    animation: show-hide 2s ease forwards;
  }


  /* Accordions */
  .accordions_item_component[open] .accordions_item_icon {
    transform: rotate(0deg);
  }

  /* Image */
  [data-parallax="1"] {
    overflow: clip;
  }
  [data-parallax="1"] img {
    animation: parallaxMove 1ms linear both;
    animation-range: cover 20% cover 80%;
    animation-timeline: --parallaxTimeline;
  }

  /* Steps Stagger */
  @media screen and (min-width: 992px) {
    .steps-stagger_item:is([data-stagger="1"]) {
      --i: 0;
      transform: translateY(calc(50% * var(--i)));
    }
    .steps-stagger_component:has(.steps-stagger_item:nth-child(4)) .steps-stagger_item { /* when there are more than 4 items */
      transform: translateY(calc(30% * var(--i)));
    }
    .steps-stagger_item:nth-child(3n+2) { --i: 1; }
    .steps-stagger_item:nth-child(3n+3) { --i: 2; }
    .steps-stagger_component:has(> .steps-stagger_item:nth-child(4)):not(:has(> .steps-stagger_item:nth-child(5))) .steps-stagger_item:nth-child(4n+4) { --i: 3; }
  }

  .testimonial_quote::before, 
  .testimonial_quote::after {
    content: '';
    mask-image: var(--_icon---quote-open);
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: center;
    background-color: var(--_theme---text-accent);
    width: 0.8em;
    height: 0.8em;
    display: inline-block;
    vertical-align: top;
  }
    .testimonial_quote::before {
      margin-right: 0.2em;
    }
  .testimonial_quote::after {
    mask-image: var(--_icon---quote-close);
     margin-left: 0.2em;
    white-space: nowrap;
  }

  .grid-custom[data-columns] {
    --repeat: 1;
    grid-template-columns: repeat(var(--repeat), minmax(0, 1fr));
  }
  @media screen and (min-width: 768px) {
    .grid-custom[data-columns="2"] { --repeat: 2; }
    .grid-custom[data-columns="3"] { --repeat: 3; }
    .grid-custom[data-columns="4"] { --repeat: 2; }
  }
  @media screen and (min-width: 992px) {
    .grid-custom[data-columns="4"] { --repeat: 4; }
  }

  @media screen and (min-width: 768px) {
    .card-stack_cards-list[data-columns="4"], 
    .cards-grid[data-columns="4"] {
      grid-template-columns: repeat(2, 1fr);
    }
        .card-stack_cards-list[data-columns="2"], 
    .cards-grid[data-columns="2"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (min-width: 992px) {
    .card-stack_cards-list[data-columns="4"],
    .cards-grid[data-columns="4"] {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .image-wrapper:has(.image-caption:not(.w-condition-invisible)) {
    margin-bottom: 2rem;
  }
  
.category-filter-link:has(.w--redirected-checked) {
  background-image: unset;
}

.display-contents > .category-filter-link:has(.w--redirected-checked) {
  background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5));
}

.news_card_component:hover > * > .news_card_image {
	transform: scale(1.03);
}

[data-fs-toc]:has(a[href="#"]:only-of-type) {
  display: none;
}
/* Vimeo videos */
  [data-video-el="vimeo"] iframe {
  height: 100%;
  pointer-events: none;
  position: absolute;
  top: 0;
  width: 100%;
}

@media (pointer: coarse) {
  [data-video-el="vimeo"] iframe {
    pointer-events: auto !important;
  }
}

[data-video-el="vimeo"] iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: max(
    100cqw,
    calc(100cqh * var(--video-ratio-x, 16) / var(--video-ratio-y, 9))
  );
  min-height: max(
    100cqh,
    calc(100cqw * var(--video-ratio-y, 9) / var(--video-ratio-x, 16))
  );
  transform: translate(-50%, -50%);
  border: 0;
}

[data-video-ratio="16/9"] {
  --video-ratio-x: 16;
  --video-ratio-y: 9;
}

[data-video-ratio="9/16"] {
  --video-ratio-x: 9;
  --video-ratio-y: 16;
}

[data-video-ratio="4/3"] {
  --video-ratio-x: 4;
  --video-ratio-y: 3;
}

[data-video-ratio="1/1"] {
  --video-ratio-x: 1;
  --video-ratio-y: 1;
}

  /* plyr.io video player */
.plyr--video {
  position: absolute;
  inset: 0;
}

.plyr--full-ui .plyr__video-embed > .plyr__video-embed__container {
  /* Overrides */
  padding: 0;
  transform: none !important;
  height: 100%;
}
</style></div><div class="w-embed"><style>
  /* Gradient blur */
  .gradient-blur {
    /* Default direction variable - can be set to "to top" or "to bottom" */
    --blur-direction: to left;
  }
  .gradient-blur > div,
  .gradient-blur::before,
  .gradient-blur::after {
    position: absolute;
    inset: 0;
  }
  .gradient-blur::before {
    content: "";
    z-index: 1;
    backdrop-filter: blur(0.5px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12.5%,
      rgba(0, 0, 0, 1) 25%,
      rgba(0, 0, 0, 0) 37.5%
    );
  }
  .gradient-blur > div:nth-of-type(1) {
    z-index: 2;
    backdrop-filter: blur(1px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 12.5%,
      rgba(0, 0, 0, 1) 25%,
      rgba(0, 0, 0, 1) 37.5%,
      rgba(0, 0, 0, 0) 50%
    );
  }
  .gradient-blur > div:nth-of-type(2) {
    z-index: 3;
    backdrop-filter: blur(2px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 25%,
      rgba(0, 0, 0, 1) 37.5%,
      rgba(0, 0, 0, 1) 50%,
      rgba(0, 0, 0, 0) 62.5%
    );
  }
  .gradient-blur > div:nth-of-type(3) {
    z-index: 4;
    backdrop-filter: blur(4px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 37.5%,
      rgba(0, 0, 0, 1) 50%,
      rgba(0, 0, 0, 1) 62.5%,
      rgba(0, 0, 0, 0) 75%
    );
  }
  .gradient-blur > div:nth-of-type(4) {
    z-index: 5;
    backdrop-filter: blur(8px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 1) 62.5%,
      rgba(0, 0, 0, 1) 75%,
      rgba(0, 0, 0, 0) 87.5%
    );
  }
  .gradient-blur > div:nth-of-type(5) {
    z-index: 6;
    backdrop-filter: blur(16px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 62.5%,
      rgba(0, 0, 0, 1) 75%,
      rgba(0, 0, 0, 1) 87.5%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  .gradient-blur > div:nth-of-type(6) {
    z-index: 7;
    backdrop-filter: blur(32px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 75%,
      rgba(0, 0, 0, 1) 87.5%,
      rgba(0, 0, 0, 1) 100%
    );
  }
  .gradient-blur::after {
    content: "";
    z-index: 8;
    backdrop-filter: blur(64px);
    mask: linear-gradient(
      var(--blur-direction),
      rgba(0, 0, 0, 0) 87.5%,
      rgba(0, 0, 0, 1) 100%
    );
  }
</style></div><div class="w-embed"><style>
  /* Reference any CSS keyframe animations here */

  /* Run full animations when user hasn't specifically requested reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    /* Fade animation initial states */
    /* [data-fade] */
    [data-fade] {
      opacity: 0;
      transform: translateY(var(--animation--fade-distance));
    }
    [data-fade="down"] {
      transform: translateY(calc(-1 * var(--animation--fade-distance)));
    }
    [data-fade="left"] {
      transform: translateX(calc(-1 * var(--animation--fade-distance)));
    }
    [data-fade="right"] {
      transform: translateX(var(--animation--fade-distance));
    }
    /* [data-fade-stagger] */
    [data-fade-stagger] *:not(.display-contents):not([class*="spacer"]):not([data-stagger-stop] *) {
      transform: translateY(var(--animation--fade-distance));
      opacity: 0;
    }
    [data-fade-stagger="down"] *:not(.display-contents):not([class*="spacer"]):not([data-stagger-stop] *) {
      transform: translateY(calc(-1 * var(--animation--fade-distance)));
    }
    [data-fade-stagger="right"] *:not(.display-contents):not([class*="spacer"]):not([data-stagger-stop] *) {
      transform: translateX(calc(-1 * var(--animation--fade-distance)));
    }
    [data-fade-stagger="left"] *:not(.display-contents):not([class*="spacer"]):not([data-stagger-stop] *) {
      transform: translateX(var(--animation--fade-distance));
    }

    [data-parallax="1"] {
      view-timeline-name: --parallaxTimeline;
      view-timeline-axis: block;
      timeline-scope: --parallaxTimeline; /* to allow descendants to use this timeline*/
    }

    
  }

  @keyframes show-hide {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes parallaxMove {
    /* Using “entry” and “exit” named timeline ranges */
    0% {
      translate: 0 0%;
    }
    100% {
      translate: 0 calc(var(--parallax, 10%) * -1);
    }
  }


.preloader_component {
  animation: movePreloader 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;
  overflow: clip;
}

.preloader_logo-wrap {
  animation: scaleLogo 0.71s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;
}
@keyframes movePreloader {
  to {
    height: 0%;
  }
}
@keyframes scaleLogo {
  to {
    transform: scale(0.8);
  }
}
