</style></div></div></div><div class="component-style w-embed"><style>
  @media screen and (max-height: 600px) {
    .hero-special_component {
      padding-bottom: 15rem;
    }
  }
  
  .hero-special_subtitle strong {
    display: inline-block;
    font-weight: inherit;
    position: relative;
  }
  .hero-special_subtitle strong::before {
    content: '';
    background: var(--_theme---background);
    inset: 0 -5px 0 -5px;
    position: absolute;
    z-index: -1;
    transform-origin: left center;
    scale: 0 1;
    transition: scale 0.3s ease-out;
  }
  html.wf-design-mode .hero-special_subtitle strong::before,
  .hero-special_subtitle.is-highlighted strong::before {
  	scale: 1 1;
  }
  
  .hero-special_title-accent {
  	text-box-trim: trim-both;
  }
  .hero-special_title-accent strong {
  	color: var(--_theme---background-secondary);
    font-weight: inherit;
  }
  /*
  .hero-special_title-accent .gsap_split_word {
  	vertical-align: top;
    margin-top: -0.3em;
