  // SPA router needs '/' — give it a <base> equal to this doc.
  try {
    var bs = document.createElement('base');
    bs.href = location.href;
    var h0 = document.head || document.documentElement;
    h0.insertBefore(bs, h0.firstChild);
  } catch(e){}
  // pushState/replaceState throw on a null origin — swallow it.
  ['pushState','replaceState'].forEach(function(m){
    var orig = history[m];
    history[m] = function(){
      try { return orig.apply(this, arguments); } catch(e){}
    };
  });
}
