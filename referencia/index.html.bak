</svg></div><div class="w-embed"><style>
  html.wf-design-mode {
    /* Hides the element in designer */
    .hide-in-designer {
      display: none;
    }

    [data-absolute-link] {
      pointer-events: none;
    }

    .dev-prompt-wrapper {
      &.w-condition-invisible {
        display: flex !important;
      }

      .dev-prompt {
        pointer-events: none;
      }

      &:has(.dev-prompt:hover, .dev-prompt-icon-wrapper:hover) {
        .dev-prompt-icon {
          opacity: 1;
        }

        .dev-prompt {
          pointer-events: auto;
          transform: none;
          opacity: 1;
        }
      }
    }

    :has(.globals[show-empty-links="true"]) {
      a[href="#"], a[href=""] {
        outline: 3px dashed orange;
        outline-offset: 3px;
      }
    }


    main:has([page-slot] > *:not([class^="section"], [class^="theme-wrapper"]))::before {
      content: "You have added a component in an invalid location. Make sure that only components with the 'Section /' prefix or 'Global / Section' are placed directly under Page Slot. \
      Other components are designed to be used within sections. For custom layout, you can place it inside a 'Global / Section Wrapper'";
      font-weight: 500;
      position: fixed;
      width: 30rem;
      height: auto;
      padding: 1.5rem;
      right: 2rem;
      top: 2rem;
      background-color: var(--_color---cherry);
      color: white;
      display: flex;
      z-index: 9999;
      border-radius: 0.5rem;
    }

    [slot-accepts]:empty {
      position: relative;
      background-color: var(--_theme---states--success-bg);
      display: flex;
      color: var(--_theme---states--success-text);
      padding: 2rem 1rem;
      font-weight: 500;
      font-size: 1rem;
      max-width: 100%;
      border: 0.125rem dashed var(--_theme---states--success-text);
      text-align: center;
      min-height: 3rem;
      line-height: 1.5;
    }


    [slot-accepts]:empty::before {
      content: "Ignite Helper";
      position: absolute;
      top: 0.5rem;
      left: 0.5rem;
      font-size: 0.7em;
      text-transform: uppercase;
      opacity: 0.5;
    }
    [slot-accepts]:empty::after {
      content: "Drag '"attr(slot-accepts)"' component here";
      margin: auto;
    }

    /* Invisible sections message */
    section:not([allow-hide]).w-condition-invisible {
      display: block !important;
    }
    section:not(.allow-hide).w-condition-invisible::before {
      content: "This section is inactive and will not show on the live site.";
      position: absolute;
      inset: 0;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(5px); /* Adds the blur effect */
      color: #000; /* Text color */
      font-size: 1.5rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 99;
      outline: 3px dashed orange;
      outline-offset: -3px;
    }

    .icon_svg.wf-empty {
      padding: 0;
    }

    /* Attribute markers and animation initial state designer overrides*/
    [data-fade-stagger] {
      position: relative;
      *:not(.display-contents):not([class*="spacer"]):not([data-stagger-stop] *) {
        opacity: 1;
        transform: none;
      }
      &::after {
        font-size: 10px;
        font-weight: 500;
        position: absolute;
        background-color: #dddddd80;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.15rem 0.25rem;
        z-index: 999;
        border: 1px solid #dddddd90;
        border-radius: 0.125rem;
        backdrop-filter: blur(4px);
        content: "[data-fade-stagger]";
      }
      &:not([data-fade-stagger=""])::after {
        content: "[data-fade-stagger]='"attr(data-fade-stagger)"'";
      }
    }
    [data-fade] {
      position: relative;
      transform: none;
      opacity: 1;
      &::after {
        font-size: 10px;
        font-weight: 500;
        position: absolute;
        background-color: #dddddd80;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.15rem 0.25rem;
        z-index: 999;
        border: 1px solid #dddddd90;
        border-radius: 0.125rem;
        backdrop-filter: blur(4px);
        content: "[data-fade]";
      }
      &:not([data-fade=""])::after {
        content: "[data-fade]='"attr(data-fade)"'";
      }
    }

    /* .preloader_component {
      display: none;
    } */

    html:not(.wf-design-mode) {
      [data-item="sample"] {
        display: none;	
      }
    }

    [data-video-el="vimeo"] {
      display: flex;
      justify-content: center;
      align-items: center;

      &::before {
        content: 'The selected Vimeo video will show on publishing to the staging site. You can preview it in the CMS "Videos" collection';
        font-size: 1.5rem;
        background: var(--_color---stone);
        color: var(--_color---slate);
        padding: 0.5rem 2rem;
      }
    }

  }
</style></div><a class="skip-to-main-content-link w--current" href="#main">Skip to main content</a><div aria-hidden="true" class="global-classes"><div class="swiper-slide-shadow"></div></div></div><div class="page-style w-embed"><style>
  @media screen and (max-width: 991px) {
    .hero-special_bg-visual.is-front {
      left: -50%;
      width: 150%;
      max-width: none;
    }

    @media screen and (max-width: 479px) {
      .hero-special_bg-visual.is-front {
        left: -100%;
        width: 200%;
      }
    }




